+'''
+Selects the SAC policy checkpoint with the lowest mean rank of raw final
+global best over the validation instances.
+
+    python -m scripts.rl.selectPolicy --exp <experiment>
+
+reads data/<experiment>/validation_results.csv and writes
+data/<experiment>/selected_policy.json.
+'''
+
+import os
+import json
+import argparse
+
+import numpy as np
+import pandas as pd
+from scipy.stats import rankdata
+
+
+def selectPolicy(csvPath, policyDir):
+    '''
+    Rank the checkpoints within each instance (function, seed) by f_final
+    (average ranks for ties, lower is better), take the lowest mean rank and
+    break an exact tie in favour of the later checkpoint.
+    '''
+    results = pd.read_csv(csvPath)
+    matrix = results.pivot(index='step', columns=['function', 'seed'], values='f_final')
+    if matrix.isna().any().any():
+        raise ValueError('Every checkpoint must be validated on the same instances')
+
+    ranks = np.apply_along_axis(rankdata, 0, matrix.to_numpy(), method='average')
+    meanRanks = ranks.mean(axis=1)
+    steps = matrix.index.to_numpy()
+
+    best = np.flatnonzero(meanRanks == meanRanks.min())
+    choice = best[np.argmax(steps[best])]  # latest checkpoint among exact ties
+    step = int(steps[choice])
+
+    return {
+        'step'         : step,
+        'path'         : os.path.join(policyDir, f'step_{step}'),
+        'mean_rank'    : float(meanRanks[choice]),
+        'n_checkpoints': int(matrix.shape[0]),
+        'n_instances'  : int(matrix.shape[1]),
+    }
+
+
+if __name__ == '__main__':
+    from scripts.const import dataDIR
+
