new file mode 100644
index 0000000..23caf0b
--- /dev/null
+++ b/scripts/tools/threads.py
@@ -0,0 +1,51 @@
+'''
+The thread settings actually in effect in this process. Training must be
+single-threaded: calypsoTrainSAC sets TensorFlow's pools and the OMP/OpenBLAS/MKL
+variables to 1.
+'''
+
+import os
+
+import tensorflow as tf
+from threadpoolctl import threadpool_info
+
+
+BLAS_ENV_VARS = ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS')
+
+
+def threadSettings():
+    '''
+    TensorFlow's thread pools, the OMP/OpenBLAS/MKL variables, the thread counts of
+    the native thread pools loaded so far (threadpoolctl), the usable CPUs and
+    whether TensorFlow sees a GPU. `warnings` lists every thread setting that is not
+    1, and a visible GPU.
+    '''
+    settings = {
+        'tf_intra_op'         : tf.config.threading.get_intra_op_parallelism_threads(),
+        'tf_inter_op'         : tf.config.threading.get_inter_op_parallelism_threads(),
+        'env'                 : {name: os.environ.get(name) for name in BLAS_ENV_VARS},
+        'native_pools'        : [
+            {key: pool[key] for key in ('user_api', 'internal_api', 'num_threads', 'filepath')}
+            for pool in threadpool_info()
+        ],
+        'usable_cpus'         : len(os.sched_getaffinity(0)),
+        'CUDA_VISIBLE_DEVICES': os.environ.get('CUDA_VISIBLE_DEVICES'),
+        'gpu_visible'         : bool(tf.config.list_physical_devices('GPU')),
+    }
+
+    warnings = []
+    for name in ('tf_intra_op', 'tf_inter_op'):
+        if settings[name] != 1:
+            warnings.append(f'{name} = {settings[name]}, not 1')
+    for name, value in settings['env'].items():
+        if value != '1':
+            warnings.append(f'{name} = {value}, not 1')
+    for pool in settings['native_pools']:
+        if pool['num_threads'] != 1:
+            warnings.append(
+                f"{pool['internal_api']} ({pool['filepath']}) uses {pool['num_threads']} threads, not 1"
+            )
+    if settings['gpu_visible']:
+        warnings.append('TensorFlow sees a GPU: CPU time does not cover all compute')
+    settings['warnings'] = warnings
+    return settings
diff --git a/scripts/tools/timing.py b/scripts/tools/timing.py
new file mode 100644
index 0000000..87d31d0
--- /dev/null
+++ b/scripts/tools/timing.py
@@ -0,0 +1,227 @@
+'''
+Wall-clock and CPU time of SAC training, per bucket, measured like edaptive's
+I/F-race tuning time (edaptive/tuning/ifrace.py, tuning_times.json).
+
+Buckets (exclusive: entering a bucket pauses the enclosing one, so no time is
+counted twice):
+- solver: the PSO runs. The env's resets (initial swarm) and steps (calypso.iter,
+  observation, reward) and the policy's action calls.
+- configurator: SAC's own work. Learner steps (including the replay sample, which
+  the learner draws inside its graph), replay adds, validation and budget
+  bookkeeping, policy selection, the training loop itself.
+- setup: everything before the first episode (imports, TF and agent construction)
+  and the graph tracing of each tf.function's first call.
+- io: logging, plots, pickles, checkpoints, PolicySaver, CSV and JSON writes.
+- framework: tf-agents driver glue (the step loop, Trajectory building, step-type
+  checks), the Actor's metric observers, cumulative_gbn and the pandas logging
+  bookkeeping (GBN, funcRanges, perfFunc/perfTrain/perfEval).
+- problem_construction: building the benchmark problem in each reset.
+
+total = solver + configurator. setup, io, framework and problem_construction are
+reported but not part of total: a standalone implementation of the method would not
+need them (as edaptive's run loop and problem construction are outside core_time).
+
+Every bucket also has parts (`part`), which only break the bucket down.
+Time spent in a bucket can also be charged to a run record (`record`), a dict with
+'solver' and 'problem_construction' entries: the per-run rows of training_runs.csv.
+'''
+
+import os
+import resource
+from contextlib import contextmanager
+from copy import deepcopy
+from time import perf_counter, process_time
+
+
+BUCKETS = ('solver', 'configurator', 'setup', 'io', 'framework', 'problem_construction')
+TOTAL_BUCKETS = ('solver', 'configurator')
+CLOCKS = ('wall', 'cpu')
+
+
+def zeroTimes():
+    return {clock: 0.0 for clock in CLOCKS}
+
+
+def addTimes(a, b):
+    return {clock: a[clock] + b[clock] for clock in CLOCKS}
+
+
+def subtractTimes(a, b):
+    return {clock: a[clock] - b[clock] for clock in CLOCKS}
+
+
+class BucketTimer:
+    '''
+    A stack of (bucket, part, record) entries. Time between two clock readings is
+    charged to the entry on top of the stack. The bottom entry is the base bucket:
+    `setup` at first, changed with `setBase`.
+    '''
+
+    def __init__(self):
+        self.parts = {}  # (bucket, part) -> times
+        self.stack = [('setup', 'other', None)]
+        self.lastWall = perf_counter()
+        self.lastCPU = process_time()
+
+    def _charge(self):
+        wall, cpu = perf_counter(), process_time()
+        bucket, part, record = self.stack[-1]
+        times = self.parts.setdefault((bucket, part), zeroTimes())
+        times['wall'] += wall - self.lastWall
+        times['cpu'] += cpu - self.lastCPU
+        if record is not None and bucket in record:
+            record[bucket]['wall'] += wall - self.lastWall
+            record[bucket]['cpu'] += cpu - self.lastCPU
+        self.lastWall, self.lastCPU = wall, cpu
+
+    @contextmanager
+    def bucket(self, bucket, part='other', record=None):
+        assert bucket in BUCKETS, bucket
+        self._charge()
+        self.stack.append((bucket, part, record))
+        try:
+            yield
+        finally:
+            self._charge()
+            self.stack.pop()
+
+    def setBase(self, bucket, part='other'):
+        assert bucket in BUCKETS, bucket
+        assert len(self.stack) == 1, f'setBase inside {self.stack[1:]}'
+        self._charge()
+        self.stack[0] = (bucket, part, None)
+
+    def timed(self, function, bucket, part='other', record=None):
+        '''`function` with each call timed in `bucket`.'''
+        def call(*args, **kwargs):
+            with self.bucket(bucket, part, record):
+                return function(*args, **kwargs)
+        return call
+
+    def snapshot(self):
+        '''Accumulated times per (bucket, part), up to now.'''
+        self._charge()
+        return deepcopy(self.parts)
+
+
+TIMER = BucketTimer()
+
+
+class TimedCallable:
+    '''
+    Forwards calls (and attribute access) to `target`, timing each call in
+    `bucket`: for objects called as `target(...)`, such as observers and triggers.
+    '''
+
+    def __init__(self, target, bucket, part):
+        self._target = target
+        self._bucket = bucket
+        self._part = part
+
+    def __call__(self, *args, **kwargs):
+        with TIMER.bucket(self._bucket, self._part):
+            return self._target(*args, **kwargs)
+
+    def __getattr__(self, name):
+        return getattr(self._target, name)
+
+
+def timeFirstCallAsSetup(function, bucket, part, record=None):
+    '''
+    `function` with its first call timed as setup (graph tracing of a tf.function)
+    and every later call in `bucket`. `record` may be a callable returning the run
+    record to charge.
+    '''
+    state = {'first': True}
+
+    def call(*args, **kwargs):
+        if state['first']:
+            state['first'] = False
+            with TIMER.bucket('setup', 'tracing'):
+                return function(*args, **kwargs)
+        with TIMER.bucket(bucket, part, record() if callable(record) else record):
+            return function(*args, **kwargs)
+    return call
+
+
+def timePolicyAction(policy, env, traced):
+    '''
+    Times `policy.action` as solver time of `env`'s current run record (an instance
+    attribute shadows the method, which the driver calls). With `traced` (a
+    PyTFEagerPolicy with use_tf_function), the first call is setup.
+    '''
+    action = policy.action
+    if traced:
+        policy.action = timeFirstCallAsSetup(action, 'solver', 'policy_action', record=lambda: env.record)
+    else:
+        def call(*args, **kwargs):
+            with TIMER.bucket('solver', 'policy_action', env.record):
+                return action(*args, **kwargs)
+        policy.action = call
+
+
+## Reports
+def bucketTotals(parts):
+    '''Times per bucket, plus total = solver + configurator.'''
+    totals = {bucket: zeroTimes() for bucket in BUCKETS}
+    for (bucket, _), times in parts.items():
+        totals[bucket] = addTimes(totals[bucket], times)
+    totals['total'] = addTimes(totals['solver'], totals['configurator'])
+    return totals
+
+
+def partBreakdown(parts):
+    '''{bucket: {part: times}}.'''
+    breakdown = {bucket: {} for bucket in BUCKETS}
+    for (bucket, part), times in sorted(parts.items()):
+        breakdown[bucket][part] = times
+    return breakdown
+
+
+def subtractParts(end, start):
+    return {key: subtractTimes(times, start.get(key, zeroTimes())) for key, times in end.items()}
+
+
+def processTimes():
+    '''
+    Wall time since this process started (/proc/self/stat start time) and its CPU
+    time (getrusage: user + system of all its threads, since exec).
+    '''
+    ticks = os.sysconf('SC_CLK_TCK')
+    with open('/proc/self/stat') as f:
+        startTicks = int(f.read().rsplit(')', 1)[1].split()[19])
+    with open('/proc/stat') as f:
+        bootTime = next(int(line.split()[1]) for line in f if line.startswith('btime'))
+    with open('/proc/uptime') as f:
+        uptime = float(f.read().split()[0])
+    usage = resource.getrusage(resource.RUSAGE_SELF)
+    return {
+        'wall': uptime - startTicks / ticks,
+        'cpu' : usage.ru_utime + usage.ru_stime,
+        'start_time': bootTime + startTicks / ticks,
+    }
+
+
+def threadCPU():
+    '''
+    CPU seconds per thread of this process (/proc/self/task), and the share of the
+    process's CPU used by threads other than the main one.
+    '''
+    ticks = os.sysconf('SC_CLK_TCK')
+    pid = os.getpid()
+    perThread = {}
+    for tid in os.listdir('/proc/self/task'):
+        try:
+            with open(f'/proc/self/task/{tid}/stat') as f:
+                fields = f.read().rsplit(')', 1)[1].split()
+        except FileNotFoundError:  # the thread ended meanwhile
+            continue
+        perThread[int(tid)] = (int(fields[11]) + int(fields[12])) / ticks  # utime + stime
+    total = sum(perThread.values())
+    other = total - perThread.get(pid, 0.0)
+    return {
+        'n_threads'          : len(perThread),
+        'main_thread_cpu'    : perThread.get(pid, 0.0),
+        'other_threads_cpu'  : other,
+        'other_threads_share': other / total if total else 0.0,
+    }
